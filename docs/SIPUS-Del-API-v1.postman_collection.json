CH","header":[],"url":"{{base_url}}/peminjamans/999999/kembalikan"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('404',()=>pm.response.to.have.status(404));"]}}]},{"name":"L15 DELETE 204","request":{"method":"DELETE","header":[],"url":"{{base_url}}/bukus/{{buku_id}}"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('204',()=>pm.response.to.have.status(204));"]}}]},{"name":"L16 DELETE ulang 404","request":{"method":"DELETE","header":[],"url":"{{base_url}}/bukus/{{buku_id}}"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('404',()=>pm.response.to.have.status(404));"]}}]}]},{"name":"6. REST Consumer OpenLibrary","item":[{"name":"C1 Referensi buku 1","request":{"method":"GET","header":[],"url":"{{base_url}}/bukus/1/referensi-eksternal","auth":{"type":"noauth"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('200/404/502/504',()=>pm.expect([200,404,502,504]).to.include(pm.response.code));"]}}]},{"name":"C2 Buku tidak ada","request":{"method":"GET","header":[],"url":"{{base_url}}/bukus/999999/referensi-eksternal","auth":{"type":"noauth"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('404',()=>pm.response.to.have.status(404));"]}}]}]},{"name":"7. Logout (jalankan terakhir)","item":[{"name":"O1 Logout","request":{"method":"POST","header":[],"url":"{{base_url}}/auth/logout"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('200',()=>pm.response.to.have.status(200));"]}}]},{"name":"O2 Me setelah logout","request":{"method":"GET","header":[],"url":"{{base_url}}/auth/me"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('401',()=>pm.response.to.have.status(401));"]}}]}]}],"variable":[{"key":"root_url","value":"http://sipus-del.test:8000"},{"key":"base_url","value":"http://sipus-del.test:8000/api/v1"},{"key":"token","value":""},{"key":"nim_aktif","value":"12S24001"},