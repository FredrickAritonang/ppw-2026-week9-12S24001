{"info":{"_postman_id":"8465e0ae-53ee-48ca-a129-3a671fbe1da4","name":"SIPUS-Del APIv1 - PPW Week 9","description":"Jalankan folder 1-7 berurutan (Collection Runner). Akun: pustakawan@del.ac.id / password123.","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},"auth":{"type":"bearer","bearer":[{"key":"token","value":"{{token}}","type":"string"}]},"event":[{"listen":"prerequest","script":{"type":"text/javascript","exec":["if(!pm.request.url.getPath().startsWith('/soap')){pm.request.headers.upsert({key:'Accept',value:'application/json'});}"]}},{"listen":"test","script":{"type":"text/javascript","exec":["const ct=pm.response.headers.get('Content-Type')||'';if(pm.response.code>=400&&ct.indexOf('xml')<0){pm.test('RFC 7807 problem+json',()=>{pm.expect(ct).to.include('application/problem+json');const p=pm.response.json();['type','title','status','detail','instance'].forEach(k=>pm.expect(p).to.have.property(k));});}"]}}],"item":[{"name":"1. SOAP Legacy","item":[{"name":"S1 GET WSDL","request":{"method":"GET","header":[],"url":"{{root_url}}/soap/sipus.wsdl","auth":{"type":"noauth"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('200',()=>pm.response.to.have.status(200));","pm.test('WSDL',()=>pm.expect(pm.response.text()).to.include('CheckClearanceStatus'));"]}}]},{"name":"S2 SOAP sukses (pinjaman aktif)","request":{"method":"POST","header":[{"key":"Content-Type","value":"text/xml; charset=utf-8"}],"url":"{{root_url}}/soap/sipus","body":{"mode":"raw","raw":"<soap:Envelope xmlns:soap='http://schemas.xmlsoap.org/soap/envelope/' xmlns:m='http://sipus.del.ac.id/soap/library'><soap:Body><m:CheckClearanceStatusRequest><m:nim_peminjam>{{nim_aktif}}</m:nim_peminjam></m:CheckClearanceStatusRequest></soap:Body></soap:Envelope>","options":{"raw":{"language":"xml"}}},"auth":{"type":"noauth"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('200',()=>pm.response.to.have.status(200));","pm.test('is_cleared false',()=>pm.expect(pm.response.text()).to.include('<m:is_cleared>false</m:is_cleared>'));"]}}]},{"name":"S3 SOAP sukses (bersih)","request":{"method":"POST","header":[{"key":"Content-Type","value":"text/xml; charset=utf-8"}],"url":"{{root_url}}/soap/sipus","body":{"mode":"raw","raw":"<soap:Envelope xmlns:soap='http://schemas.xmlsoap.org/soap/envelope/' xmlns:m='http://sipus.del.ac.id/soap/library'><soap:Body><m:CheckClearanceStatusRequest><m:nim_peminjam>{{nim_bersih}}</m:nim_peminjam></m:CheckClearanceStatusRequest></soap:Body></soap:Envelope>","options":{"raw":{"language":"xml"}}},"auth":{"type":"noauth"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('200',()=>pm.response.to.have.status(200));","pm.test('is_cleared true',()=>pm.expect(pm.response.text()).to.include('<m:is_cleared>true</m:is_cleared>'));"]}}]},{"name":"S4 SOAP Fault (nim kosong)","request":{"method":"POST","header":[{"key":"Content-Type","value":"text/xml; charset=utf-8"}],"url":"{{root_url}}/soap/sipus","body":{"mode":"raw","raw":"<soap:Envelope xmlns:soap='http://schemas.xmlsoap.org/soap/envelope/' xmlns:m='http://sipus.del.ac.id/soap/library'><soap:Body><m:CheckClearanceStatusRequest><m:nim_peminjam></m:nim_peminjam></m:CheckClearanceStatusRequest></soap:Body></soap:Envelope>","options":{"raw":{"language":"xml"}}},"auth":{"type":"noauth"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('500',()=>pm.response.to.have.status(500));","pm.test('Fault',()=>pm.expect(pm.response.text()).to.include('soap:Fault'));"]}}]},{"name":"S5 SOAP Fault (XML cacat)","request":{"method":"POST","header":[{"key":"Content-Type","value":"text/xml; charset=utf-8"}],"url":"{{root_url}}/soap/sipus","body":{"mode":"raw","raw":"<soap:Envelope><soap:Body>","options":{"raw":{"language":"xml"}}},"auth":{"type":"noauth"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('500',()=>pm.response.to.have.status(500));","pm.test('Fault',()=>pm.expect(pm.response.text()).to.include('soap:Fault'));"]}}]}]},{"name":"2. Auth Bearer Token","item":[{"name":"A1 Login (simpan token)","request":{"method":"POST","header":[],"url":"{{base_url}}/auth/login","body":{"mode":"raw","raw":"{\"email\":\"pustakawan@del.ac.id\",\"password\":\"password123\"}","options":{"raw":{"language":"json"}}},"auth":{"type":"noauth"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('200',()=>pm.response.to.have.status(200));","pm.collectionVariables.set('token',pm.response.json().data.access_token);"]}}]},{"name":"A2 Login password salah","request":{"method":"POST","header":[],"url":"{{base_url}}/auth/login","body":{"mode":"raw","raw":"{\"email\":\"pustakawan@del.ac.id\",\"password\":\"salah\"}","options":{"raw":{"language":"json"}}},"auth":{"type":"noauth"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('401',()=>pm.response.to.have.status(401));"]}}]},{"name":"A3 Login body kosong","request":{"method":"POST","header":[],"url":"{{base_url}}/auth/login","body":{"mode":"raw","raw":"{}","options":{"raw":{"language":"json"}}},"auth":{"type":"noauth"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('422',()=>pm.response.to.have.status(422));","pm.test('errors',()=>pm.expect(pm.response.json().errors).to.have.property('email'));"]}}]},{"name":"A4 Me (Bearer)","request":{"method":"GET","header":[],"url":"{{base_url}}/auth/me"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('200',()=>pm.response.to.have.status(200));","pm.test('role',()=>pm.expect(pm.response.json().data.role).to.eql('pustakawan'));"]}}]},{"name":"A5 POST bukus tanpa token","request":{"method":"POST","header":[],"url":"{{base_url}}/bukus","body":{"mode":"raw","raw":"{}","options":{"raw":{"language":"json"}}},"auth":{"type":"noauth"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('401',()=>pm.response.to.have.status(401));"]}}]}]},{"name":"3. Katalog Baca (publik)","item":[{"name":"B1 GET bukus","request":{"method":"GET","header":[],"url":"{{base_url}}/bukus","auth":{"type":"noauth"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('200',()=>pm.response.to.have.status(200));","pm.test('meta',()=>pm.expect(pm.response.json().meta).to.have.property('total_items'));"]}}]},{"name":"B2 filter+sort","request":{"method":"GET","header":[],"url":"{{base_url}}/bukus?search=a&tersedia=1&sort=-stok&per_page=3","auth":{"type":"noauth"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('200',()=>pm.response.to.have.status(200));","pm.test('stok>0 + pinjam_buku',()=>pm.response.json().data.forEach(b=>{pm.expect(b.stok).to.be.above(0);pm.expect(b._links).to.have.property('pinjam_buku');}));"]}}]},{"name":"B3 detail id 1","request":{"method":"GET","header":[],"url":"{{base_url}}/bukus/1","auth":{"type":"noauth"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('200',()=>pm.response.to.have.status(200));","pm.test('detail',()=>{const d=pm.response.json().data;pm.expect(d).to.have.property('kategori');pm.expect(d).to.have.property('riwayat_peminjaman');});"]}}]},{"name":"B4 id tidak ada","request":{"method":"GET","header":[],"url":"{{base_url}}/bukus/999999","auth":{"type":"noauth"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('404',()=>pm.response.to.have.status(404));"]}}]},{"name":"B5 endpoint salah","request":{"method":"GET","header":[],"url":"{{base_url}}/bukuz","auth":{"type":"noauth"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('404',()=>pm.response.to.have.status(404));"]}}]},{"name":"B6 per_page=999","request":{"method":"GET","header":[],"url":"{{base_url}}/bukus?per_page=999","auth":{"type":"noauth"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('422',()=>pm.response.to.have.status(422));"]}}]}]},{"name":"4. Katalog Mutasi (PUT vs PATCH)","item":[{"name":"W1 POST kosong","request":{"method":"POST","header":[],"url":"{{base_url}}/bukus","body":{"mode":"raw","raw":"{}","options":{"raw":{"language":"json"}}}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('422',()=>pm.response.to.have.status(422));","pm.test('errors',()=>pm.expect(pm.response.json().errors).to.have.property('isbn'));"]}}]},{"name":"W2 POST valid 201","request":{"method":"POST","header":[],"url":"{{base_url}}/bukus","body":{"mode":"raw","raw":"{\"isbn\":\"{{isbn_uji}}\",\"judul\":\"Rekayasa Layanan Web dengan Laravel\",\"penulis\":\"Fredrick Aritonang\",\"penerbit\":\"Institut Teknologi Del\",\"tahun_terbit\":2026,\"kategori_id\":1,\"stok\":1,\"sinopsis\":\"Kelas A\"}","options":{"raw":{"language":"json"}}}},"event":[{"listen":"prerequest","script":{"type":"text/javascript","exec":["pm.collectionVariables.set('isbn_uji','978'+Date.now().toString().slice(-10));"]}},{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('201',()=>pm.response.to.have.status(201));","pm.test('Location',()=>pm.expect(pm.response.headers.get('Location')).to.match(/bukus.[0-9]+$/));","pm.collectionVariables.set('buku_id',pm.response.json().data.id);"]}}]},{"name":"W3 ISBN duplikat","request":{"method":"POST","header":[],"url":"{{base_url}}/bukus","body":{"mode":"raw","raw":"{\"isbn\":\"{{isbn_uji}}\",\"judul\":\"Rekayasa Layanan Web dengan Laravel\",\"penulis\":\"Fredrick Aritonang\",\"penerbit\":\"Institut Teknologi Del\",\"tahun_terbit\":2026,\"kategori_id\":1,\"stok\":1,\"sinopsis\":\"Kelas A\"}","options":{"raw":{"language":"json"}}}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('422',()=>pm.response.to.have.status(422));"]}}]},{"name":"W4 PATCH stok","request":{"method":"PATCH","header":[],"url":"{{base_url}}/bukus/{{buku_id}}","body":{"mode":"raw","raw":"{\"stok\":2}","options":{"raw":{"language":"json"}}}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('200',()=>pm.response.to.have.status(200));","pm.test('PATCH',()=>{const d=pm.response.json().data;pm.expect(d.stok).to.eql(2);pm.expect(d.sinopsis).to.eql('Kelas A');});"]}}]},{"name":"W5 PATCH kosong","request":{"method":"PATCH","header":[],"url":"{{base_url}}/bukus/{{buku_id}}","body":{"mode":"raw","raw":"{}","options":{"raw":{"language":"json"}}}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('400',()=>pm.response.to.have.status(400));"]}}]},{"name":"W6 PUT tanpa sinopsis","request":{"method":"PUT","header":[],"url":"{{base_url}}/bukus/{{buku_id}}","body":{"mode":"raw","raw":"{\"isbn\":\"{{isbn_uji}}\",\"judul\":\"Rekayasa Layanan Web (Ed. 2)\",\"penulis\":\"Fredrick Aritonang\",\"penerbit\":\"Institut Teknologi Del\",\"tahun_terbit\":2026,\"kategori_id\":1,\"stok\":2}","options":{"raw":{"language":"json"}}}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('200',()=>pm.response.to.have.status(200));","pm.test('PUT reset',()=>pm.expect(pm.response.json().data.sinopsis).to.eql(null));"]}}]},{"name":"W7 PUT tidak lengkap","request":{"method":"PUT","header":[],"url":"{{base_url}}/bukus/{{buku_id}}","body":{"mode":"raw","raw":"{\"judul\":\"x\"}","options":{"raw":{"language":"json"}}}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('422',()=>pm.response.to.have.status(422));"]}}]}]},{"name":"5. Sirkulasi ACID","item":[{"name":"L1 Pinjam 201","request":{"method":"POST","header":[],"url":"{{base_url}}/peminjamans","body":{"mode":"raw","raw":"{\"buku_id\":\"{{buku_id}}\",\"nim_peminjam\":\"12S22005\",\"nama_peminjam\":\"Siti Nurhaliza\"}","options":{"raw":{"language":"json"}}}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('201',()=>pm.response.to.have.status(201));","pm.test('Location',()=>pm.expect(pm.response.headers.get('Location')).to.match(/peminjamans.[0-9]+$/));","pm.collectionVariables.set('peminjaman_id',pm.response.json().data.id);"]}}]},{"name":"L2 Duplikat 409","request":{"method":"POST","header":[],"url":"{{base_url}}/peminjamans","body":{"mode":"raw","raw":"{\"buku_id\":\"{{buku_id}}\",\"nim_peminjam\":\"12S22005\",\"nama_peminjam\":\"Siti Nurhaliza\"}","options":{"raw":{"language":"json"}}}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('409',()=>pm.response.to.have.status(409));"]}}]},{"name":"L3 NIM lain (stok jadi 0)","request":{"method":"POST","header":[],"url":"{{base_url}}/peminjamans","body":{"mode":"raw","raw":"{\"buku_id\":\"{{buku_id}}\",\"nim_peminjam\":\"12S22006\",\"nama_peminjam\":\"Budi Santoso\"}","options":{"raw":{"language":"json"}}}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('201',()=>pm.response.to.have.status(201));","pm.collectionVariables.set('peminjaman_id_2',pm.response.json().data.id);"]}}]},{"name":"L4 Stok habis 422","request":{"method":"POST","header":[],"url":"{{base_url}}/peminjamans","body":{"mode":"raw","raw":"{\"buku_id\":\"{{buku_id}}\",\"nim_peminjam\":\"12S22007\",\"nama_peminjam\":\"Stok Habis\"}","options":{"raw":{"language":"json"}}}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('422',()=>pm.response.to.have.status(422));"]}}]},{"name":"L5 Buku tidak ada","request":{"method":"POST","header":[],"url":"{{base_url}}/peminjamans","body":{"mode":"raw","raw":"{\"buku_id\":999999,\"nim_peminjam\":\"12S22005\",\"nama_peminjam\":\"Siti\"}","options":{"raw":{"language":"json"}}}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('404',()=>pm.response.to.have.status(404));"]}}]},{"name":"L6 Body kosong","request":{"method":"POST","header":[],"url":"{{base_url}}/peminjamans","body":{"mode":"raw","raw":"{}","options":{"raw":{"language":"json"}}}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('422',()=>pm.response.to.have.status(422));"]}}]},{"name":"L7 Filter s